#include <stdio.h>

int count_key(const int a[], int n, int key){
    int count = 0;
    for (int i = 0; i < n; i++)
    if (a[i] == key)
        count ++;
    return count;
}
int first_key(const int a[], int n, int key) {
    for (int i = 0; i<n; i++)
    if (a[i] == key)
        return i;
    return -1;
}

int main(void) {
    int a[] = {2, 7, 2, -1, 2};
    int n = 5;
    
    int keys[] = {2, 7, 9};
    for (int k = 0; k < 3; k++) {
        int key = keys[k];
        printf("key = %d count = %d first = %d\n", key, count_key(a, n, key), first_key(a, n, key));
    }
    return 0;
}
